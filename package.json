{
  "name": "llm-wiki-concept",
  "version": "1.0.0",
  "description": "PulsarWiki — local browser interface for the pulsar astronomy knowledge base",
  "homepage": "https://github.com/rudrathegreat/pulsar-wiki-electron",
  "main": "desktop/main.js",
  "desktopName": "pulsarwiki.desktop",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "electron .",
    "build:windows": "electron-builder --win nsis --publish never",
    "build:linux": "electron-builder --linux deb --x64 --publish never",
    "test": "node --test",
    "build:notebooks": "npm --prefix integrations/jupyterlab ci && npm --prefix integrations/jupyterlab run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "chokidar": "^5.0.0",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "jose": "^6.1.0",
    "katex": "^0.16.22",
    "marked": "^18.0.2",
    "openai": "^7.21.0",
    "pdfjs-dist": "^5.4.624",
    "ws": "^8.20.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.pulsarwiki.desktop",
    "productName": "PulsarWiki",
    "asar": false,
    "files": [
      "desktop/main.js",
      "server.js",
      "agent/**/*",
      "public/**/*",
      "integrations/jupyter/**/*",
      "integrations/jupyterlab/extensions/**/*",
      "favicon.ico",
      "LICENSE"
    ],
    "win": {
      "icon": "pulsar-wiki-logo.svg",
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "PulsarWiki-Setup-${version}-${arch}.${ext}",
      "createDesktopShortcut": true
    },
    "linux": {
      "icon": "pulsar-wiki-logo.svg",
      "executableName": "pulsarwiki",
      "category": "Science",
      "syncDesktopName": true,
      "target": "deb"
    },
    "deb": {
      "artifactName": "pulsarwiki_${version}_${arch}.${ext}",
      "packageName": "pulsarwiki",
      "maintainer": "PulsarWiki <37140269+rudrathegreat@users.noreply.github.com>",
      "packageCategory": "science",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libnotify4",
        "libnss3",
        "libsecret-1-0",
        "libuuid1",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    }
  }
}
